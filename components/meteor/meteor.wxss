/* 流星通知层：盖在所有内容之上，但只有落地后的星星可点 */
.meteor-layer { position: fixed; inset: 0; z-index: 200; pointer-events: none; }

/* ══ 第一幕：流星划破（右上 → 左下，亮头在前，长尾在后） ══ */
.meteor-streak {
  position: absolute; left: 0; top: 0; opacity: 0;
  animation: meteorStreak 1.6s linear forwards;
}
@keyframes meteorStreak {
  0% { transform: translate(88vw, -14vh); opacity: 0; }
  7% { opacity: 1; }
  88% { opacity: 1; }
  100% { transform: translate(22vw, 42vh); opacity: 0; }
}
/* body 逆时针 35°：+x 方向（尾巴）指向右上，头朝左下，正对运动方向 */
.ms-body { position: absolute; left: 0; top: 0; transform: rotate(-35deg); }

/* 主尾焰：左宽右尖的锥形，贴着头部向后拖 */
.ms-tail {
  position: absolute; left: 12rpx; top: -5rpx; width: 330rpx; height: 10rpx;
  clip-path: polygon(0 0, 100% 50%, 0 100%);
  background: linear-gradient(90deg,
    rgba(255,248,230,.95) 0%, rgba(255,214,150,.55) 32%,
    rgba(255,206,138,.20) 62%, rgba(255,206,138,0) 100%);
}
/* 副尾焰：短一截、偏蓝的冷光，和主尾错开 3°，叠出层次 */
.ms-tail.t2 {
  width: 190rpx; height: 6rpx; top: 3rpx; left: 14rpx;
  transform: rotate(3deg); transform-origin: 0 50%;
  background: linear-gradient(90deg,
    rgba(196,208,255,.8) 0%, rgba(169,188,255,.30) 45%, rgba(169,188,255,0) 100%);
}
/* 尾部散落的火星子，各自闪烁 */
.ms-spark {
  position: absolute; border-radius: 50%;
  background: #FFE9BE; box-shadow: 0 0 8px 3px rgba(255,214,150,.8);
  animation: sparkTw .6s ease-in-out infinite;
}
.ms-spark.sp1 { left: 70rpx; top: -16rpx; width: 6rpx; height: 6rpx; }
.ms-spark.sp2 { left: 126rpx; top: 12rpx; width: 5rpx; height: 5rpx; animation-delay: .2s; }
.ms-spark.sp3 { left: 188rpx; top: -9rpx; width: 4rpx; height: 4rpx; animation-delay: .4s; }
@keyframes sparkTw {
  0%, 100% { opacity: .15; transform: scale(.7); }
  50% { opacity: .9; transform: scale(1.15); }
}

/* 亮头：白热核心 + 十字星芒 */
.ms-head {
  position: absolute; left: 0; top: 0; transform: translate(-50%, -50%);
  width: 18rpx; height: 18rpx; border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #FFFFFF 0%, #FFF3D8 45%, #FFC978 100%);
  box-shadow: 0 0 16px 6px rgba(255,244,220,.95), 0 0 56px 22px rgba(255,214,150,.45);
}
.ms-flare-h, .ms-flare-v { position: absolute; left: 0; top: 0; transform: translate(-50%, -50%); }
.ms-flare-h { width: 72rpx; height: 2rpx; background: linear-gradient(90deg, rgba(255,250,235,0), rgba(255,250,235,.9), rgba(255,250,235,0)); }
.ms-flare-v { width: 2rpx; height: 72rpx; background: linear-gradient(180deg, rgba(255,250,235,0), rgba(255,250,235,.9), rgba(255,250,235,0)); }

/* ══ 第二幕：坠落（重力加速，尾焰朝上拖） ══ */
.meteor-fall {
  position: absolute; left: 22%; top: 42%;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #FFFDF6 0%, #FFE9BE 55%, #F2B96D 100%);
  box-shadow: 0 0 14px 5px rgba(255,230,180,.85), 0 -18rpx 30rpx 10rpx rgba(255,214,150,.35);
  animation: meteorFall .9s cubic-bezier(.6, .05, .9, .5) forwards;
}
@keyframes meteorFall {
  0% { transform: translate(0, 0) scale(1); opacity: 1; }
  70% { opacity: 1; }
  100% { transform: translate(6vw, 26vh) scale(.5); opacity: 0; }
}

/* ══ 第三幕：落地的星，落地瞬间荡开一圈光 ══ */
.meteor-chip {
  position: absolute; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 260rpx);
  transform: translateX(-50%);
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 36rpx; border-radius: 999rpx;
  background: rgba(11,15,31,.95);
  border: 1rpx solid rgba(255,206,138,.42);
  box-shadow: 0 10rpx 44rpx rgba(0,0,0,.55), 0 0 34rpx rgba(255,206,138,.14);
  pointer-events: auto;
  animation: chipRise .55s cubic-bezier(.2, .9, .3, 1.2);
  white-space: nowrap;
}
.meteor-chip-tap { opacity: .8; }
.mc-halo {
  position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 140rpx; height: 140rpx; border-radius: 50%;
  border: 2rpx solid rgba(255,206,138,.55);
  animation: mcHalo 1.4s ease-out forwards;
}
@keyframes mcHalo {
  0% { transform: translate(-50%, -50%) scale(.5); opacity: .8; }
  100% { transform: translate(-50%, -50%) scale(2.6); opacity: 0; }
}
.mc-star {
  width: 26rpx; height: 26rpx; flex: none;
  background: #FFCE8A;
  clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%);
  box-shadow: 0 0 12px 4px rgba(255,206,138,.9);
  animation: mcPulse 1.8s ease-in-out infinite;
}
@keyframes mcPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); }
}
.mc-txt { font-size: 24rpx; letter-spacing: .12em; color: #D8DDF2; }
.mc-go { margin-top: 6rpx; font-size: 20rpx; letter-spacing: .3em; color: #FFCE8A; }
@keyframes chipRise {
  0% { transform: translate(-50%, 60rpx); opacity: 0; }
  100% { transform: translate(-50%, 0); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .meteor-streak, .meteor-fall { animation-duration: .4s; }
  .ms-spark, .mc-star { animation: none; }
  .mc-halo { display: none; }
}
