/* 流星通知层：盖在所有内容之上，但只有落地后的星星可点 */
.meteor-layer { position: fixed; inset: 0; z-index: 200; pointer-events: none; }

/* 第一幕：流星划破（右上 → 左下） */
.meteor-streak {
  position: absolute; left: 0; top: 0;
  width: 220rpx; height: 4rpx; border-radius: 4rpx;
  background: linear-gradient(90deg, rgba(255,240,210,0) 0%, rgba(255,240,210,.45) 55%, rgba(255,252,240,.95) 100%);
  transform-origin: 100% 50%;
  opacity: 0;
  animation: meteorStreak 1.5s ease-in forwards;
}
.ms-head {
  position: absolute; right: -6rpx; top: 50%; transform: translateY(-50%);
  width: 14rpx; height: 14rpx; border-radius: 50%;
  background: #FFFDF6;
  box-shadow: 0 0 12px 4px rgba(255,240,210,.9), 0 0 36px 12px rgba(255,214,150,.35);
}
@keyframes meteorStreak {
  0% { transform: translate(72vw, -12vh) rotate(-35deg); opacity: 0; }
  10% { opacity: 1; }
  85% { opacity: 1; }
  100% { transform: translate(-6vw, 40vh) rotate(-35deg); opacity: 0; }
}

/* 第二幕：光点坠落 */
.meteor-fall {
  position: absolute; left: 30%; top: 44%;
  width: 16rpx; height: 16rpx; border-radius: 50%;
  background: radial-gradient(circle at 40% 35%, #FFFDF6 0%, #FFE9BE 55%, #F2B96D 100%);
  box-shadow: 0 0 14px 5px rgba(255,230,180,.85), 0 0 44px 16px rgba(255,214,150,.3);
  animation: meteorFall .9s cubic-bezier(.55,.1,.8,.4) forwards;
}
@keyframes meteorFall {
  0% { transform: translateY(0) scale(1); opacity: 1; }
  70% { opacity: 1; }
  100% { transform: translateY(26vh) scale(.55); opacity: 0; }
}

/* 第三幕：落地的星，等人来拆 */
.meteor-chip {
  position: absolute; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 260rpx);
  transform: translateX(-50%);
  display: flex; align-items: center; gap: 18rpx;
  padding: 22rpx 36rpx; border-radius: 999rpx;
  background: rgba(11,15,31,.95);
  border: 1rpx solid rgba(255,206,138,.42);
  box-shadow: 0 10rpx 44rpx rgba(0,0,0,.55), 0 0 34rpx rgba(255,206,138,.14);
  pointer-events: auto;
  animation: chipRise .55s cubic-bezier(.2,.9,.3,1.2);
  white-space: nowrap;
}
.meteor-chip-tap { opacity: .8; }
.mc-star {
  width: 26rpx; height: 26rpx; flex: none;
  background: #FFCE8A;
  clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%);
  box-shadow: 0 0 12px 4px rgba(255,206,138,.9);
  animation: mcPulse 1.8s ease-in-out infinite;
}
@keyframes mcPulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.25); }
}
.mc-txt { font-size: 24rpx; letter-spacing: .12em; color: #D8DDF2; }
.mc-go { margin-top: 6rpx; font-size: 20rpx; letter-spacing: .3em; color: #FFCE8A; }
@keyframes chipRise {
  0% { transform: translate(-50%, 60rpx); opacity: 0; }
  100% { transform: translate(-50%, 0); opacity: 1; }
}

@media (prefers-reduced-motion: reduce) {
  .meteor-streak, .meteor-fall { animation-duration: .4s; }
  .mc-star { animation: none; }
}
