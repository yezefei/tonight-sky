<view class="page" style="padding-top:{{navTop}}px">
  <view class="back" hover-class="tap" style="top:{{capTop}}px;height:{{capH}}px" bindtap="goBack">‹</view>
  <view class="h2">今晚，慢慢说</view>
  <view class="sub">现在，最让你放不下的是什么？</view>
  <view class="tiny">不用组织语言。哪怕只有一句，也可以。</view>

  <view class="write-box">
    <textarea class="worry" placeholder="想到什么就写什么，几个词也行" placeholder-class="ph"
      value="{{text}}" bindinput="onInput" maxlength="2000" auto-height focus="{{focus}}"></textarea>
  </view>
  <view style="margin-top:20rpx"><text class="starter-link" bindtap="useStarter">不知道从何说起？借一句话开头</text></view>

  <view class="tiny" style="margin-top:40rpx">想选个大方向也行，不选也没关系</view>
  <view class="chips">
    <view wx:for="{{chips}}" wx:key="*this" hover-class="tap"
      class="chip {{tag === item ? 'sel' : ''}}" bindtap="pickChip" data-v="{{item}}">{{item}}</view>
  </view>

  <view class="spacer"></view>
  <view class="btn-main {{canDone ? '' : 'dis'}}" hover-class="btn-hover" bindtap="done">说 完 了</view>
  <view class="link-quiet" hover-class="tap" bindtap="goCalm">写不出来，就陪我安静一会儿</view>
  <view style="height:60rpx"></view>
  <meteor />
</view>
