.write-box { margin-top: 20rpx; background: rgba(255,255,255,.04); border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx; padding: 28rpx; }
.worry { width: 100%; min-height: 180rpx; color: #eef0f7; font-size: 32rpx; line-height: 2; }
.ph { color: #7c84a6; }
/* 字数提示：平时很淡，接近 2000 字上限时提亮提醒 */
.count-hint {
  margin-top: 12rpx; text-align: right; font-family: monospace;
  font-size: 20rpx; letter-spacing: .06em; color: #5b6280;
}
.count-hint.near { color: #ffd79a; }
.chips { display: flex; flex-wrap: wrap; margin-top: 20rpx; }
.chip {
  flex: 0 0 auto; width: auto;
  padding: 14rpx 30rpx; border-radius: 999rpx; font-size: 26rpx;
  background: none; border: 1rpx solid rgba(255,255,255,.10); color: #8b90a8;
  margin: 0 16rpx 16rpx 0; line-height: 1.8;
}
.chip.sel { border-color: rgba(255,215,154,.5); color: #ffd79a; background: rgba(255,215,154,.06); }
.mood-label { margin-top: 14rpx; }
/* 可选标记默认折叠：写之前不像在填表 */
.optional-toggle {
  display: inline-block; margin-top: 24rpx; padding: 14rpx 24rpx;
  border: 1rpx solid rgba(200,210,255,.16); border-radius: 999rpx;
  color: #7c84a6; font-size: 23rpx; letter-spacing: .06em;
}

/* 草稿恢复提示 */
.draft-hint { margin-top: 18rpx; font-size: 22rpx; color: #7c84a6; letter-spacing: .1em; }
.draft-clear { color: #b9c3ff; border-bottom: 1rpx solid rgba(185,195,255,.5); padding-bottom: 2rpx; }

/* 借一句话开头：从 dotted 小字改成可见的胶囊入口，明确「点了会发生什么」 */
.starter-pill {
  display: inline-block; margin-top: 20rpx; padding: 16rpx 28rpx;
  border: 1rpx solid rgba(255,215,154,.28); border-radius: 999rpx;
  background: rgba(255,215,154,.04); color: rgba(255,215,154,.78);
  font-size: 24rpx; letter-spacing: .06em;
}

/* 语音输入 */
.voice-row { margin-top: 24rpx; }
.voice-btn {
  display: inline-flex; align-items: center; gap: 14rpx;
  padding: 16rpx 30rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(255,255,255,.12); color: #8b90a8;
  font-size: 24rpx; letter-spacing: .16em;
}
.voice-btn.on { border-color: rgba(255,215,154,.5); color: #ffd79a; }
/* 麦克风图标：胶囊机身 + U 形支架 + 底座 */
.mic { position: relative; width: 14rpx; height: 22rpx; border-radius: 7rpx; background: #8b90a8; }
.mic::after {
  content: ''; position: absolute; left: 50%; top: 16rpx; width: 22rpx; height: 14rpx;
  transform: translateX(-50%);
  border: 2rpx solid #8b90a8; border-top: none; border-radius: 0 0 11rpx 11rpx;
}
.voice-btn.on .mic { background: #ffd79a; animation: micPulse 1.2s ease-in-out infinite; }
.voice-btn.on .mic::after { border-color: #ffd79a; }
@keyframes micPulse { 0%, 100% { opacity: 1; } 50% { opacity: .3; } }
.voice-live { margin-top: 16rpx; color: #7c84a6; font-size: 24rpx; line-height: 1.8; }
.voice-err { margin-top: 14rpx; color: #c98f8f; font-size: 22rpx; line-height: 1.7; }
