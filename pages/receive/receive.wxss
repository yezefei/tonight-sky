.center-note { flex: 1; display: flex; align-items: center; justify-content: center; color: #525771; font-size: 27rpx; letter-spacing: .1em; }

.star-card {
  margin-top: 48rpx; background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx; padding: 40rpx 36rpx;
}
.star-text { font-size: 33rpx; line-height: 2.1; color: #fff6e3; font-family: "Songti SC", "STSong", serif; }

.reply-card { margin-top: 32rpx; border-left: 2rpx solid rgba(255,215,154,.4); padding-left: 24rpx; }
.reply-meta { font-size: 22rpx; color: #ffd79a; letter-spacing: .2em; margin-bottom: 12rpx; }
.reply-text { font-size: 30rpx; line-height: 2; color: #8b90a8; }

.keep-row {
  margin-top: 44rpx; text-align: center; padding: 24rpx 0;
  border: 1rpx solid rgba(255,215,154,.3); border-radius: 999rpx;
  color: #ffd79a; font-size: 28rpx; letter-spacing: .14em;
  font-family: "Songti SC", "STSong", serif;
}
.keep-row.kept { border-color: rgba(255,215,154,.12); opacity: .6; }

.reply-box { margin-top: 20rpx; background: rgba(255,255,255,.04); border: 1rpx solid rgba(255,255,255,.08); border-radius: 24rpx; padding: 24rpx; }
.reply-input { width: 100%; min-height: 120rpx; color: #eef0f7; font-size: 30rpx; line-height: 1.9; }
.ph { color: #525771; }
