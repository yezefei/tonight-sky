<view class="page-list" style="padding-top:{{navTop}}px">
  <!-- 类型页签：全部 / 心事 / 有回音 / 已翻篇 -->
  <view class="type-tabs">
    <view wx:for="{{types}}" wx:key="key" hover-class="tap"
      class="type-tab {{type === item.key ? 'on' : ''}}"
      data-v="{{item.key}}" bindtap="pickType">{{item.label}}</view>
  </view>

  <!-- 页头：深空观测台 -->
  <view class="sl-head">
    <view class="sl-eyebrow">{{meta.eyebrow}}</view>
    <view class="sl-title">{{meta.title}}</view>
    <view class="sl-sub">{{meta.hint}} · 共 {{count}} 颗</view>
  </view>
  <view class="sl-hairline"></view>

  <!-- 近况回顾：纯本机统计，情绪强度不上传 -->
  <view wx:if="{{review.week.count || review.month.count}}" class="review-card">
    <view class="review-eyebrow">近 况 · 仅 本 机 统 计</view>
    <view class="review-row">
      <view class="review-cell">
        <view class="review-num">{{review.week.count}}</view>
        <view class="review-lbl">近 7 天</view>
      </view>
      <view class="review-cell">
        <view class="review-num">{{review.month.count}}</view>
        <view class="review-lbl">这 个 月</view>
      </view>
      <view class="review-cell">
        <view class="review-num">{{review.week.days || '—'}}</view>
        <view class="review-lbl">写过几天</view>
      </view>
    </view>
    <view wx:if="{{review.week.top}}" class="review-note">这一周写过「{{review.week.top}}」</view>
  </view>

  <!-- 标签筛选：这一类型里出现过的标签；右侧渐隐+箭头提示还能往左滑 -->
  <view wx:if="{{tags.length}}" class="tag-scroll-wrap">
    <scroll-view scroll-x enhanced show-scrollbar="{{false}}" class="tag-scroll">
      <view class="tag-chip {{tag === '' ? 'sel' : ''}}" hover-class="tap" bindtap="pickTag" data-v="">全部</view>
      <view wx:for="{{tags}}" wx:key="*this" class="tag-chip {{tag === item ? 'sel' : ''}}"
        hover-class="tap" bindtap="pickTag" data-v="{{item}}">{{item}}</view>
    </scroll-view>
    <block wx:if="{{tags.length > 3}}">
      <view class="tag-scroll-fade"></view>
      <view class="tag-scroll-more">→</view>
    </block>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!items.length}}" class="sl-empty">
    <view class="empty-star {{type}}"></view>
    <view class="empty-txt">{{meta.empty}}</view>
  </view>

  <!-- 星志卡片（按月份分组，触底分批加载） -->
  <block wx:for="{{items}}" wx:key="id">
    <view wx:if="{{item.group}}" class="sl-group">{{item.group}}</view>
    <view class="sl-card" hover-class="sl-card-tap"
      bindtap="openStar" data-id="{{item.id}}">
      <view class="card-top">
        <view class="star-ic {{item.cls}}"></view>
        <view class="card-idx">NO.{{item.idx}}</view>
        <view class="card-del" hover-class="tap" catchtap="delStar" data-id="{{item.id}}">删除</view>
      </view>
      <view class="card-txt">{{item.text}}</view>
      <view class="card-meta">{{item.meta}}</view>
      <view wx:if="{{item.mood}}" class="card-mood">那时：{{item.mood}}</view>

      <view wx:if="{{item.reply}}" class="reply-card">
        <view class="reply-meta">回音</view>
        <view class="reply-text">{{item.reply}}</view>
      </view>
      <view wx:elif="{{item.sent}}" class="sent-tag">已送出 · 等一颗回音</view>
      <view wx:if="{{item.done}}" class="gold-tag">已翻篇 ✦</view>
    </view>
  </block>

  <view wx:if="{{hasMore}}" class="sl-hint">下 滑 · 再 翻 十 五 颗</view>
  <view wx:elif="{{items.length}}" class="sl-hint">— 到 底 啦 · 轻 触 卡 片 看 这 颗 星 —</view>

  <meteor />
</view>
