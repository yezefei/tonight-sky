/* 星志列表页 · 深空观测台 */
.page-list {
  position: relative;
  min-height: 100vh;
  padding: 0 56rpx calc(env(safe-area-inset-bottom) + 208rpx);
  box-sizing: border-box;
  background: radial-gradient(120% 70% at 50% 30%, #0B1128 0%, #060913 46%, #030409 100%);
  color: #eef0f7;
}

/* 页头 */
/* 星空 tab 顶部类型页签 */
.type-tabs {
  display: flex; align-items: center; justify-content: space-between;
  margin: 8rpx 0 0; padding: 8rpx;
  border: 1rpx solid rgba(255,255,255,.07); border-radius: 999rpx;
  background: rgba(255,255,255,.025);
}
.type-tab {
  flex: 1; text-align: center; padding: 14rpx 0;
  font-size: 25rpx; letter-spacing: .1em; color: #7c84a6;
  border-radius: 999rpx;
}
.type-tab.on {
  color: #ffd79a; background: rgba(255,215,154,.08);
  box-shadow: inset 0 0 0 1rpx rgba(255,215,154,.18);
}

.sl-head { text-align: center; margin-top: 40rpx; }
.sl-eyebrow {
  font-family: monospace; font-size: 20rpx; letter-spacing: .4em; text-indent: .4em;
  color: rgba(169,188,255,.75);
}
.sl-title {
  margin-top: 18rpx;
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 56rpx; font-weight: 600; letter-spacing: .28em; text-indent: .28em;
  color: #F2EDD9;
}
.sl-sub { margin-top: 14rpx; font-size: 22rpx; letter-spacing: .22em; text-indent: .22em; color: #8b90a8; }
.sl-hairline {
  margin: 36rpx 16rpx 8rpx; height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,210,255,.14), transparent);
}

/* 近况回顾：本地统计，不上传 */
.review-card {
  margin: 20rpx 0 4rpx; padding: 28rpx 24rpx 24rpx;
  border-radius: 22rpx; border: 1rpx solid rgba(200,210,255,.1);
  background: linear-gradient(160deg, rgba(16,21,48,.5), rgba(8,10,24,.55));
}
.review-eyebrow {
  font-family: monospace; font-size: 18rpx; letter-spacing: .26em;
  color: rgba(169,188,255,.7); text-align: center;
}
.review-row { display: flex; margin-top: 24rpx; }
.review-cell { flex: 1; text-align: center; }
.review-num {
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 44rpx; color: #ffd79a; line-height: 1.2;
}
.review-lbl { margin-top: 8rpx; font-size: 20rpx; letter-spacing: .12em; color: #8b90a8; }
.review-note {
  margin-top: 22rpx; padding-top: 18rpx; text-align: center;
  border-top: 1rpx solid rgba(200,210,255,.08);
  font-size: 22rpx; color: #b9c3ff; letter-spacing: .08em;
}

/* 空状态 */
.sl-empty { padding: 140rpx 0 80rpx; text-align: center; }
.empty-star { width: 30rpx; height: 30rpx; margin: 0 auto 36rpx; border-radius: 50%; background: rgba(244,241,230,.35); box-shadow: 0 0 12px 3px rgba(244,241,230,.2); }
.empty-star.gold {
  border-radius: 0; background: rgba(255,206,138,.5); box-shadow: 0 0 12px 3px rgba(255,206,138,.3);
  clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%);
}
.empty-star.replied { background: rgba(169,188,255,.45); box-shadow: 0 0 12px 3px rgba(169,188,255,.25); }
.empty-txt { font-size: 24rpx; line-height: 2.2; letter-spacing: .14em; color: #4A5168; white-space: pre-line; }

/* 星志卡片 */
.sl-card {
  margin-top: 32rpx; padding: 32rpx 32rpx 30rpx; border-radius: 22rpx;
  background: linear-gradient(160deg, rgba(16,21,48,.5), rgba(8,10,24,.6));
  border: 1rpx solid rgba(200,210,255,.1);
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,.04);
}
.sl-card-tap { opacity: .72; }
.card-top { display: flex; align-items: center; margin-bottom: 20rpx; }

/* 星形图标：三类形态与星空页一致 */
.star-ic { width: 18rpx; height: 18rpx; flex: none; border-radius: 50%; background: #F4F1E6; box-shadow: 0 0 8px 2px rgba(244,241,230,.5); }
.star-ic.replied { position: relative; background: #A9BCFF; box-shadow: 0 0 8px 2px rgba(160,178,255,.6); }
.star-ic.replied::after { content: ''; position: absolute; left: -7rpx; top: -7rpx; right: -7rpx; bottom: -7rpx; border-radius: 50%; border: 1.5rpx solid rgba(178,192,255,.85); }
.star-ic.gold {
  width: 22rpx; height: 22rpx; border-radius: 0;
  background: radial-gradient(circle, #FFE9C4 0%, #FFCE8A 55%, #C98F3F 100%);
  clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%);
  filter: drop-shadow(0 0 8px rgba(255,206,138,.8));
}

.card-idx {
  margin-left: 18rpx; flex: 1;
  font-family: monospace; font-size: 20rpx; letter-spacing: .28em; color: rgba(169,188,255,.65);
}
.card-del { flex: none; padding: 12rpx 10rpx; font-size: 22rpx; letter-spacing: .12em; color: #a87f7f; }

.card-txt {
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 31rpx; line-height: 1.9; color: #E8E4D6;
  display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 4; overflow: hidden;
}
.card-meta { margin-top: 18rpx; font-family: monospace; font-size: 20rpx; letter-spacing: .12em; color: #7c84a6; }
.card-mood { margin-top: 12rpx; font-size: 21rpx; letter-spacing: .1em; color: #ffd79a; }

/* 回音块 */
.reply-card {
  margin-top: 24rpx; padding: 22rpx 26rpx; border-radius: 16rpx;
  background: rgba(169,188,255,.05); border-left: 3rpx solid rgba(169,188,255,.45);
}
.reply-meta { font-family: monospace; font-size: 18rpx; letter-spacing: .3em; color: rgba(169,188,255,.7); margin-bottom: 10rpx; }
.reply-text { font-size: 27rpx; line-height: 1.9; color: #C6D2F5; }

.sent-tag { margin-top: 22rpx; font-size: 21rpx; letter-spacing: .2em; color: #7c84a6; }
.gold-tag { margin-top: 22rpx; font-size: 21rpx; letter-spacing: .24em; color: #C9A86A; }

.sl-hint { margin-top: 60rpx; text-align: center; font-size: 20rpx; letter-spacing: .3em; text-indent: .3em; color: #7c84a6; }

/* 月份分组标题 */
.sl-group {
  margin: 48rpx 0 4rpx; display: flex; align-items: center;
  font-family: monospace; font-size: 20rpx; letter-spacing: .34em; color: rgba(169,188,255,.6);
}
.sl-group::after {
  content: ''; flex: 1; margin-left: 24rpx; height: 1rpx;
  background: linear-gradient(90deg, rgba(200,210,255,.12), transparent);
}

/* 标签筛选 */
.tag-scroll-wrap { position: relative; }
.tag-scroll { margin: 26rpx 0 2rpx; padding-right: 64rpx; box-sizing: border-box; white-space: nowrap; }
.tag-scroll-fade {
  position: absolute; right: 0; top: 0; bottom: 0; width: 76rpx;
  pointer-events: none; background: linear-gradient(90deg, rgba(6,9,19,0), #060913 86%);
}
.tag-scroll-more {
  position: absolute; right: 14rpx; top: 50%; transform: translateY(-50%);
  color: #b9c3ff; font-size: 24rpx; pointer-events: none;
}
.tag-chip {
  display: inline-block; margin-right: 16rpx; padding: 10rpx 26rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(200,210,255,.14); font-size: 20rpx; letter-spacing: .2em; color: #8b90a8;
}
.tag-chip.sel { border-color: rgba(255,206,138,.45); color: #FFCE8A; background: rgba(255,206,138,.06); }

/* 矮屏：收紧页头与卡片留白，让首屏能看到更多条目 */
@media (max-height: 700px) {
  .sl-head { margin-top: 20rpx; }
  .sl-title { font-size: 46rpx; margin-top: 12rpx; }
  .sl-hairline { margin-top: 22rpx; }
  .review-card { padding: 20rpx 20rpx 18rpx; }
  .review-row { margin-top: 16rpx; }
  .sl-card { margin-top: 24rpx; padding: 24rpx 24rpx 22rpx; }
  .sl-group { margin-top: 30rpx; }
  .sl-empty { padding: 80rpx 0 56rpx; }
}
