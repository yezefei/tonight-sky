/* 呼吸页 · 4-7-8：浅色呼吸球 + 薄荷色进度环，沿用夜空底色 */
.calm-page { height: 100vh; overflow: hidden; }

.calm-back {
  color: #C9D2F2; border: 1rpx solid rgba(232,236,255,.22); border-radius: 999rpx;
}

.calm-eyebrow {
  position: absolute; left: 0; right: 0; top: 196rpx; text-align: center;
  font-family: monospace; font-size: 18rpx; letter-spacing: .38em; color: #6C7699;
}
.calm-title {
  position: absolute; left: 0; right: 0; top: 244rpx; text-align: center;
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 40rpx; font-weight: 600; letter-spacing: .3em; text-indent: .3em; color: #EDF0FF;
}
.calm-sub {
  position: absolute; left: 0; right: 0; top: 322rpx; text-align: center;
  font-size: 22rpx; letter-spacing: .3em; color: #8b90a8;
}

/* 4-7-8 舞台：canvas 圆环 + 中央呼吸球 */
.calm-stage { position: absolute; left: 50%; top: 48%; transform: translate(-50%, -50%); width: 500rpx; height: 500rpx; }
.breath-ring { position: absolute; left: 0; top: 0; z-index: 1; }
.breath-halo {
  position: absolute; left: 50%; top: 50%; width: 440rpx; height: 440rpx;
  margin-left: -220rpx; margin-top: -220rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(143,201,184,.20) 0%, rgba(143,201,184,.07) 56%, rgba(143,201,184,0) 72%);
  filter: blur(4rpx); z-index: 0;
}
.breath-orb {
  position: absolute; left: 50%; top: 50%; width: 340rpx; height: 340rpx;
  margin-left: -170rpx; margin-top: -170rpx; border-radius: 50%; z-index: 2;
  background: radial-gradient(circle at 38% 30%, #FCFFFC 0%, #EAF6EF 32%, #CBE4D9 68%, #A9CFC1 100%);
  box-shadow:
    inset 0 0 44rpx rgba(255,255,255,.82),
    0 0 56rpx rgba(143,201,184,.34),
    0 0 120rpx rgba(121,184,170,.18);
  transform: scale(.76);
}
/* 吸 4s 涨大 → 屏 7s 稳住 → 呼 8s 收小，与圆环和倒数严格同频 */
.breath-orb.in { animation: orbIn 4s linear both; }
.breath-orb.hold { animation: orbHold 7s ease-in-out both; }
.breath-orb.out { animation: orbOut 8s linear both; }
@keyframes orbIn {
  from { transform: scale(.76); }
  to { transform: scale(1.06); }
}
@keyframes orbHold {
  0% { transform: scale(1.06); }
  50% { transform: scale(1.09); }
  100% { transform: scale(1.06); }
}
@keyframes orbOut {
  from { transform: scale(1.06); }
  to { transform: scale(.76); }
}
.orb-shine {
  position: absolute; left: 14%; top: 10%; width: 58%; height: 42%;
  border-radius: 50%; background: radial-gradient(circle at 50% 50%, rgba(255,255,255,.8), rgba(255,255,255,0) 70%);
  opacity: .7;
}

/* 中央：大数字倒数 + 阶段 + 提示 */
.breath-center {
  position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%);
  text-align: center; z-index: 3; pointer-events: none;
}
.breath-count {
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 112rpx; line-height: 1.1; font-weight: 600; color: #2F5A50;
  text-shadow: 0 2rpx 10rpx rgba(255,255,255,.7);
}
.breath-phase {
  margin-top: 10rpx; font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 40rpx; font-weight: 600; letter-spacing: .4em; text-indent: .4em; color: #3E6F63;
}
.breath-en {
  margin-top: 6rpx; font-family: monospace; font-size: 18rpx;
  letter-spacing: .42em; text-indent: .42em; color: #6B9388;
}
.breath-hint {
  margin-top: 20rpx; font-size: 20rpx; letter-spacing: .06em; color: #5D7C74;
}

/* 底部控件成组排布：避免说明 / 按钮 / 退出三块各自 absolute 导致贴在一起 */
.calm-controls {
  position: absolute; left: 56rpx; right: 56rpx;
  bottom: calc(env(safe-area-inset-bottom) + 108rpx);
  display: flex; flex-direction: column; align-items: center;
}
.calm-tempo {
  margin-top: 0; margin-bottom: 36rpx;
  text-align: center; font-family: monospace; font-size: 18rpx; letter-spacing: .12em; color: #7c84a6;
}
/* 暂停 / 模式切换并排，避免多一个按钮就把底部挤满 */
.calm-btn-row {
  display: flex; gap: 20rpx; width: 100%; max-width: 560rpx; margin-bottom: 32rpx;
}
.calm-half {
  flex: 1; min-width: 0; margin-top: 0; padding: 20rpx 0;
  font-size: 23rpx; letter-spacing: .1em; color: #9ed7c6;
  border-color: rgba(158,215,198,.32); background: rgba(158,215,198,.05);
}
.calm-quit {
  width: 100%; margin-top: 0;
  font-size: 22rpx; letter-spacing: .26em; color: #8b90a8;
}
/* 暂停时冻结光球与光晕动画，与计时/圆环一致 */
.breath-orb.paused, .breath-halo.paused { animation-play-state: paused; }

@media (prefers-reduced-motion: reduce) {
  .breath-orb.in, .breath-orb.hold, .breath-orb.out { animation: none; transform: scale(.92); }
}

/* 五轮呼吸后的收尾 */
.calm-fin { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; padding-bottom: 12vh; animation: finIn 1.2s ease; }
@keyframes finIn { from { opacity: 0; transform: translateY(20rpx); } to { opacity: 1; transform: none; } }
.fin-star {
  width: 34rpx; height: 34rpx; margin-bottom: 48rpx;
  background: radial-gradient(circle, #FFE9C4 0%, #FFCE8A 55%, #C98F3F 100%);
  clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%);
  filter: drop-shadow(0 0 14px rgba(255,206,138,.75));
  animation: finPulse 2.4s ease-in-out infinite;
}
@keyframes finPulse { 0%, 100% { transform: scale(1); opacity: .85; } 50% { transform: scale(1.18); opacity: 1; } }
.fin-title { font-family: 'Songti SC', 'Noto Serif CJK SC', serif; font-size: 48rpx; letter-spacing: .24em; text-indent: .24em; color: #F2EDD9; }
.fin-sub { margin-top: 24rpx; font-size: 24rpx; letter-spacing: .18em; color: #8b90a8; }
.fin-btn { margin-top: 72rpx; width: 100%; }
.calm-again { width: 100%; margin-top: 28rpx; }
.calm-stay { margin-top: 16rpx; color: #8b90a8; }
