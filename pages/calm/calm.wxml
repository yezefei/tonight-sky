<view class="page calm-page" style="padding-top:{{navTop}}px">
  <view class="back calm-back" hover-class="tap" style="top:{{capTop}}px;height:{{capH}}px" bindtap="goBack">‹</view>

  <view class="calm-eyebrow">CALM · STARLIGHT ORBIT</view>
  <view class="calm-title">跟 着 光 点 呼 吸</view>
  <view class="calm-sub">光点走完一圈，就是一口气</view>

  <!-- 呼吸轨道：光点 4 秒走半圈（吸），6 秒走剩下半圈（呼） -->
  <view class="calm-stage">
    <view class="calm-path"></view>
    <view wx:for="{{ticks}}" wx:key="index" class="calm-tick {{item.lg ? 'lg' : ''}}"
      style="transform:rotate({{item.deg}}deg)"></view>
    <view class="comet-spin {{spinning ? 'go' : ''}}">
      <view class="trail t1"></view>
      <view class="trail t2"></view>
      <view class="trail t3"></view>
      <view class="trail t4"></view>
      <view class="comet"></view>
    </view>
    <view class="calm-center">
      <view class="calm-phase">{{breathTxt}}</view>
      <view class="calm-count">{{count}}</view>
    </view>
  </view>

  <view class="calm-tempo">IN 4S · OUT 6S · ROUND {{round}}</view>
  <view class="link-quiet calm-quit" hover-class="tap" bindtap="goBack">我差不多了</view>
</view>
