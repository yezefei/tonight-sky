.card-wrap { flex: 1; display: flex; align-items: center; justify-content: center; padding: 32rpx 0; min-height: 58vh; }
.card-img { width: 540rpx; height: 864rpx; border-radius: 24rpx; box-shadow: 0 24rpx 90rpx rgba(0,0,0,.55); }
.card-loading { color: #525771; font-size: 26rpx; letter-spacing: .1em; }
.offscreen { position: fixed; left: -2000px; top: 0; }
