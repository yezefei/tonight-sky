.eyebrow {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx; letter-spacing: .34em; color: rgba(169,188,255,.75);
  margin-bottom: 18rpx;
}
.h2 { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; letter-spacing: .06em; }
.intro { color: #8b90a8; font-size: 27rpx; line-height: 2; margin-top: 14rpx; }

.overview {
  display: flex; margin-top: 36rpx; padding: 30rpx 0;
  border: 1rpx solid rgba(255,255,255,.07); border-radius: 28rpx;
  background: rgba(255,255,255,.02);
}
.ov-cell { flex: 1; text-align: center; }
.ov-num {
  font-family: "Songti SC", "STSong", serif; font-size: 50rpx; color: #ffd79a; line-height: 1.2;
}
.ov-lbl { margin-top: 8rpx; font-size: 22rpx; color: #7c84a6; letter-spacing: .08em; }

.section-title {
  margin: 48rpx 8rpx 18rpx; font-size: 22rpx; letter-spacing: .22em; color: #7c84a6;
}
.section-title.spaced { margin-top: 40rpx; }

.entry-card {
  display: flex; align-items: center; gap: 24rpx;
  padding: 30rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx;
  background: rgba(255,255,255,.02);
}
.entry-card.slim { padding: 26rpx 28rpx; }
.entry-main { flex: 1; min-width: 0; }
.entry-title {
  font-family: "Songti SC", "STSong", serif; font-size: 32rpx; color: #f2edd9; letter-spacing: .06em;
}
.entry-desc {
  margin-top: 10rpx; font-size: 23rpx; color: #8b90a8; line-height: 1.6;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.entry-side { display: flex; align-items: baseline; color: #ffd79a; }
.side-num { font-family: "Songti SC", "STSong", serif; font-size: 38rpx; }
.side-unit { font-size: 20rpx; color: #8b90a8; margin-left: 4rpx; }
.arrow { color: #7c84a6; font-size: 30rpx; margin-left: 16rpx; }

/* 纯 CSS 的小日历图标 */
.cal-icon {
  width: 76rpx; height: 76rpx; flex: none;
  border: 1rpx solid rgba(255,215,154,.35); border-radius: 16rpx;
  background: rgba(255,215,154,.05); overflow: hidden;
}
.cal-top { height: 16rpx; border-bottom: 1rpx solid rgba(255,215,154,.3); }
.cal-grid { display: flex; flex-wrap: wrap; padding: 10rpx 10rpx 0; gap: 8rpx; }
.cal-grid text {
  width: 14rpx; height: 14rpx; border-radius: 4rpx;
  background: rgba(255,215,154,.28);
}
.cal-grid text:last-child { background: #ffd79a; }

.bottom-space { height: calc(env(safe-area-inset-bottom) + 208rpx); }

@media (max-height: 700px) {
  .intro { margin-top: 8rpx; font-size: 25rpx; }
  .overview { margin-top: 24rpx; padding: 22rpx 0; }
  .ov-num { font-size: 44rpx; }
  .section-title { margin-top: 28rpx; }
  .entry-card { padding: 22rpx 24rpx; }
}
