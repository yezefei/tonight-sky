.eyebrow {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx; letter-spacing: .34em; color: rgba(169,188,255,.75);
  margin-bottom: 18rpx;
}
.h2 { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; letter-spacing: .06em; }
.intro { color: #8b90a8; font-size: 27rpx; line-height: 2; margin-top: 18rpx; }

.card {
  margin-top: 48rpx; padding: 8rpx 32rpx;
  border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx;
  background: rgba(255,255,255,.02);
}
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 30rpx 0; min-height: 120rpx;
  border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.row:last-child { border-bottom: none; }
.row-main { flex: 1; padding-right: 30rpx; }
.row-title { font-size: 30rpx; color: #f2edd9; letter-spacing: .06em; }
.row-title.danger { color: #c98f8f; }
.row-desc { font-size: 23rpx; color: #6b7189; line-height: 1.8; margin-top: 10rpx; }
.tapable { opacity: 1; }
.arrow { color: #525771; font-size: 34rpx; }
.mini-btn {
  padding: 14rpx 26rpx; border: 1rpx solid rgba(255,206,138,.35);
  border-radius: 999rpx; color: #ffce8a; font-size: 24rpx; white-space: nowrap;
}

.privacy { margin-top: 60rpx; padding: 0 8rpx 60rpx; }
.privacy-title { font-size: 24rpx; color: #a9bcff; letter-spacing: .18em; margin-bottom: 16rpx; }
.privacy-line { font-size: 23rpx; color: #525771; line-height: 2; margin-top: 12rpx; }
