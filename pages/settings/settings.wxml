<view class="page" style="padding-top:{{navTop}}px">
  <view class="eyebrow">PROFILE · MINE</view>
  <view class="h2">我的夜空</view>
  <view class="intro">你写下的，都在这里。</view>

  <view class="overview">
    <view class="ov-cell">
      <view class="ov-num">{{total}}</view>
      <view class="ov-lbl">我的星星</view>
    </view>
    <view class="ov-cell">
      <view class="ov-num">{{goldCount}}</view>
      <view class="ov-lbl">已经翻篇</view>
    </view>
    <view class="ov-cell">
      <view class="ov-num">{{repliedCount}}</view>
      <view class="ov-lbl">收到回音</view>
    </view>
  </view>

  <view class="section-title">回看</view>
  <view class="entry-card" hover-class="tap" bindtap="goCalendar">
    <view class="cal-icon">
      <view class="cal-top"></view>
      <view class="cal-grid"><text></text><text></text><text></text><text></text></view>
    </view>
    <view class="entry-main">
      <view class="entry-title">心情日历</view>
      <view class="entry-desc">翻翻这个月，哪几天写下了心事</view>
    </view>
    <view class="entry-side">
      <text class="side-num">{{monthDays}}</text>
      <text class="side-unit">天</text>
      <text class="arrow">→</text>
    </view>
  </view>

  <view class="section-title spaced">数据与隐私</view>
  <view class="entry-card slim" hover-class="tap" bindtap="goPrivacy">
    <view class="entry-main">
      <view class="entry-title">隐私与数据</view>
      <view class="entry-desc">同步 · 导出 · 清空，都在这里</view>
    </view>
    <view class="arrow">→</view>
  </view>

  <view class="bottom-space"></view>
  <meteor />
</view>
