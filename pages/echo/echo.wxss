/* 确认页：收紧行距，把「它会变成星」和下一步动作突出出来 */
.echo .sub { margin-top: 16rpx; line-height: 1.9; }
.echo-guide {
  margin-top: 28rpx; color: #8b90a8; font-size: 24rpx; line-height: 1.9;
  border-left: 2rpx solid rgba(255,215,154,.35); padding-left: 20rpx;
}
.echo-back { margin-top: 20rpx; color: #b9c3ff; }

.quote-card {
  margin-top: 36rpx; background: rgba(255,255,255,.04);
  border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx; padding: 36rpx;
  transition: opacity .5s ease;
}
.tag {
  display: inline-block; font-size: 20rpx; color: #b9c3ff;
  border: 1rpx solid rgba(185,195,255,.3); border-radius: 999rpx;
  padding: 4rpx 18rpx; margin-bottom: 20rpx;
}
.quote-text { font-size: 33rpx; line-height: 2.1; font-family: "Songti SC", "STSong", serif; }
/* 长原文先收起，避免把主按钮挤到屏幕外；点开可看全文 */
.quote-text.clamp { max-height: 252rpx; overflow: hidden; }
.quote-more {
  margin-top: 16rpx; text-align: right;
  font-size: 22rpx; letter-spacing: .1em; color: #8b90a8;
}
.ghost {
  position: fixed; z-index: 50; pointer-events: none;
  color: #fff6e3; font-size: 33rpx; line-height: 2.1; font-family: "Songti SC", "STSong", serif;
  transition: transform 1.9s cubic-bezier(.45,.05,.35,1), opacity 1.9s ease, filter 1.9s ease;
}
@media (prefers-reduced-motion: reduce) {
  .ghost { transition-duration: .6s; }
}
