<view class="page" style="padding-top:{{navTop}}px">
  <view class="back" hover-class="tap" style="top:{{capTop}}px;height:{{capH}}px" bindtap="goBack">‹<text class="back-txt">返回</text></view>

  <view class="eyebrow">PRIVACY · DATA</view>
  <view class="h2">隐私与数据</view>
  <view class="intro">这些心事放在哪里，由你决定。</view>

  <view class="note-card">
    <view class="note-title">说在前面</view>
    <view class="note-text">心事默认只留在这台设备。开启同步后，文字会加密存入云数据库，密钥由服务端保管。送出的星 30 天后自动删除。情绪强度和心情词只留在本机，不上传。</view>
  </view>

  <view class="card">
    <view class="row">
      <view class="row-main">
        <view class="row-title">云同步</view>
        <view class="row-desc">加密上传，换设备也能找回</view>
      </view>
      <switch checked="{{syncOn}}" bindchange="onSyncToggle" color="#FFCE8A" />
    </view>
    <view class="row sub-row" wx:if="{{syncOn}}">
      <view class="row-main">
        <view class="row-title small">上次同步</view>
        <view class="row-desc">{{lastText}}</view>
      </view>
      <view class="mini-btn" hover-class="tap" bindtap="syncNow">立即同步</view>
    </view>
    <view class="row">
      <view class="row-main">
        <view class="row-title">回音提醒</view>
        <view class="row-desc">{{notifyText}}</view>
      </view>
      <view class="mini-btn" hover-class="tap" bindtap="enableNotify">{{notifyOn ? '已 开 启' : '重 新 开 启'}}</view>
    </view>
    <view class="row tapable" hover-class="tap" bindtap="exportData">
      <view class="row-main">
        <view class="row-title">导出我的星星</view>
        <view class="row-desc">复制成文字，由你自己保管</view>
      </view>
      <view class="arrow">→</view>
    </view>
    <view class="row tapable" hover-class="tap" bindtap="clearData">
      <view class="row-main">
        <view class="row-title danger">清空本地数据</view>
        <view class="row-desc">清掉后无法撤销</view>
      </view>
      <view class="arrow">→</view>
    </view>
  </view>

  <view class="bottom-space"></view>
  <view class="toast {{toast ? 'on' : ''}}">{{toast}}</view>
  <meteor />
</view>
