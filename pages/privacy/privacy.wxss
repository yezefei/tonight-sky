.back {
  position: fixed; left: 28rpx; z-index: 30;
  display: flex; align-items: center; gap: 10rpx;
  color: #b9c3ff; font-size: 52rpx; line-height: 1;
}
.back-txt { font-size: 26rpx; letter-spacing: .1em; }

.eyebrow {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx; letter-spacing: .34em; color: rgba(169,188,255,.75);
  margin-bottom: 18rpx;
}
.h2 { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; letter-spacing: .06em; }
.intro { color: #8b90a8; font-size: 27rpx; line-height: 2; margin-top: 14rpx; }

.note-card {
  margin-top: 32rpx; padding: 28rpx 30rpx;
  border: 1rpx solid rgba(255,215,154,.16); border-radius: 28rpx;
  background: rgba(255,215,154,.03);
}
.note-title { font-size: 26rpx; color: #ffd79a; letter-spacing: .12em; }
.note-text { margin-top: 14rpx; font-size: 24rpx; line-height: 1.95; color: #b9c3ff; }

.card {
  margin-top: 32rpx; padding: 4rpx 28rpx;
  border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx;
  background: rgba(255,255,255,.02);
}
.row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; min-height: 104rpx;
  border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.row:last-child { border-bottom: none; }
.row-main { flex: 1; min-width: 0; padding-right: 20rpx; }
.row-title { font-size: 29rpx; color: #f2edd9; letter-spacing: .06em; }
.row-title.small { font-size: 25rpx; color: #b9c3ff; }
.row-title.danger { color: #c98f8f; }
.row-desc {
  margin-top: 8rpx; font-size: 22rpx; color: #6b7189; line-height: 1.6;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.sub-row { background: rgba(255,255,255,.015); }
.arrow { color: #7c84a6; font-size: 32rpx; }
.mini-btn {
  padding: 12rpx 20rpx; border: 1rpx solid rgba(255,206,138,.35);
  border-radius: 999rpx; color: #ffce8a; font-size: 22rpx; white-space: nowrap;
}

.bottom-space { height: calc(env(safe-area-inset-bottom) + 60rpx); }

@media (max-height: 700px) {
  .intro { margin-top: 8rpx; font-size: 25rpx; }
  .note-card, .card { margin-top: 22rpx; }
  .row { padding: 18rpx 0; min-height: 92rpx; }
  .row-title { font-size: 27rpx; }
  .row-desc { font-size: 21rpx; }
}
