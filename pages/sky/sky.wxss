.sky-layer { position: absolute; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; }
.bg-star { position: absolute; width: 4rpx; height: 4rpx; border-radius: 50%; background: #cdd3ee; opacity: .22; animation: tw 7s ease-in-out infinite; }
.sky-star {
  position: absolute; border-radius: 50%; pointer-events: auto;
  background: #fff6e3;
  box-shadow: 0 0 8px 2px rgba(255,246,227,.55), 0 0 22px 6px rgba(255,246,227,.18);
  animation: tw 5s ease-in-out infinite;
}
@keyframes tw { 50% { opacity: .45; } }
.sky-star.fresh { animation: born 2.6s ease-out forwards; z-index: 5; }
@keyframes born {
  0% { box-shadow: 0 0 0 0 rgba(255,246,227,.9); opacity: 0; transform: scale(.2); }
  25% { opacity: 1; transform: scale(1.9); box-shadow: 0 0 30px 10px rgba(255,246,227,.8), 0 0 90px 40px rgba(185,195,255,.35); }
  60% { transform: scale(1); }
  100% { box-shadow: 0 0 8px 2px rgba(255,246,227,.55), 0 0 22px 6px rgba(255,246,227,.18); }
}
.sky-star.turning { animation: turnGold 2.2s ease-out forwards; z-index: 5; }
@keyframes turnGold {
  0% { transform: scale(1); }
  30% { transform: scale(2.1); background: #FFCE8A; box-shadow: 0 0 26px 10px rgba(255,206,138,.95), 0 0 80px 30px rgba(255,206,138,.45); }
  100% { transform: scale(1); background: #FFCE8A; box-shadow: 0 0 12px 4px rgba(255,206,138,.95), 0 0 34px 12px rgba(255,206,138,.42); }
}
.sky-star.beckon { animation: beckon 4.5s ease-in-out infinite; }
@keyframes beckon {
  0%, 100% { box-shadow: 0 0 8px 2px rgba(255,246,227,.55), 0 0 30px 8px rgba(255,215,154,.10); }
  50% { box-shadow: 0 0 8px 2px rgba(255,246,227,.7), 0 0 52px 16px rgba(255,215,154,.30); }
}

/* 轨道页入口：「已经有 N 颗星星」那句话本身是可点的 */
.sub-link .link-em { border-bottom: 1rpx dotted rgba(255,215,154,.45); padding-bottom: 3rpx; }

@keyframes sunPulse {
  0%, 100% { box-shadow: 0 0 24rpx 8rpx rgba(255,215,154,.5), 0 0 90rpx 30rpx rgba(255,215,154,.18); }
  50% { box-shadow: 0 0 30rpx 12rpx rgba(255,215,154,.62), 0 0 120rpx 44rpx rgba(255,215,154,.26); }
}

/* 首屏星点纯装饰 */
.sky-star.deco { pointer-events: none; }

/* 恒星轨道视图：深空观测台（OLED 深黑 + 仪器风） */
.orbit-view {
  position: fixed; inset: 0; z-index: 60;
  background: radial-gradient(120% 70% at 50% 34%, #0B1128 0%, #060913 46%, #030409 100%);
  opacity: 0; pointer-events: none; transition: opacity .45s ease;
}
.orbit-view.on { opacity: 1; pointer-events: auto; }
.orbit-back {
  color: #C9D2F2; border: 1rpx solid rgba(232,236,255,.22); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
}
/* 顶部标题组 */
.orbit-head { position: absolute; left: 0; right: 0; top: 190rpx; text-align: center; }
.orbit-eyebrow { font-family: monospace; font-size: 18rpx; letter-spacing: .42em; color: #6C7699; }
.orbit-title { margin-top: 14rpx; font-family: 'Songti SC', 'Noto Serif CJK SC', serif; font-size: 44rpx; font-weight: 600; letter-spacing: .3em; text-indent: .3em; color: #EDF0FF; }
.orbit-date { margin-top: 14rpx; font-family: monospace; font-size: 20rpx; letter-spacing: .3em; color: #5A6284; }
/* 恒星：小而锐的精密核心 + 仪器十字丝 */
.orbit-stage { position: absolute; left: 50%; top: 44%; width: 0; height: 0; }
.sun-halo {
  position: absolute; left: 0; top: 0; transform: translate(-50%, -50%);
  width: 288rpx; height: 288rpx; border-radius: 50%;
  background: radial-gradient(circle, rgba(255,232,190,.20) 0%, rgba(255,232,190,.05) 42%, rgba(255,232,190,0) 70%);
}
.sun-cross-h, .sun-cross-v { position: absolute; background: rgba(255,240,210,.28); }
.sun-cross-h { left: -88rpx; width: 176rpx; top: 0; height: 1px; }
.sun-cross-v { top: -88rpx; height: 176rpx; left: 0; width: 1px; }
.sun-core {
  position: absolute; left: 0; top: 0; transform: translate(-50%, -50%);
  width: 68rpx; height: 68rpx; border-radius: 50%;
  background: radial-gradient(circle at 38% 34%, #FFFDF6 0%, #FFE9BE 45%, #F2B96D 100%);
  box-shadow: 0 0 18px 4px rgba(255,230,180,.75), 0 0 60px 18px rgba(255,214,150,.22);
  animation: sunPulse 5s ease-in-out infinite;
}
.orbit-ring {
  position: absolute; left: 0; top: 0; transform: translate(-50%, -50%);
  border: 1rpx solid rgba(200,210,255,.09); border-radius: 50%;
  animation-name: orbitSpin; animation-timing-function: linear; animation-iteration-count: infinite;
  /* 轨道容器本身是透明大方块，不吃点击，只让星的热区响应——
     否则最大的环盖在最上层，内侧的星永远点不到 */
  pointer-events: none;
}
@keyframes orbitSpin {
  from { transform: translate(-50%, -50%) rotate(0deg); }
  to { transform: translate(-50%, -50%) rotate(360deg); }
}
/* 点击热区：透明包裹层 72rpx，视觉星点保持小巧 */
.orbit-hit {
  position: absolute; transform: translate(-50%, -50%);
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  pointer-events: auto;
}
/* 轨道刻度线：绕环心旋转的小短线（transform-origin 由内联样式按半径给出） */
.orbit-tick {
  position: absolute; left: 50%; top: 0; width: 1px; height: 10rpx;
  background: rgba(200,210,255,.12);
}
/* 轨道编号：ORBIT L1/L2/L3，钉在每条环的正上方 */
.orbit-ringlabel {
  position: absolute; left: 0; transform: translateX(-50%);
  font-family: monospace; font-size: 16rpx; letter-spacing: .24em; color: #4A5170; white-space: nowrap;
}
/* 星星的等宽编号 01/02…，按写下时间排序 */
.orbit-idx {
  position: absolute; left: 48rpx; top: 50%; transform: translateY(-50%);
  font-family: monospace; font-size: 16rpx; letter-spacing: .14em; color: #596183;
}
/* 形状区分三种星：心事 = 暖白圆点；有回音 = 蓝色圆点带外环；已翻篇 = 金色四角星 */
.orbit-star {
  position: relative; border-radius: 50%; background: #F4F1E6;
  box-shadow: 0 0 8px 2px rgba(244,241,230,.75), 0 0 22px 6px rgba(244,241,230,.2);
  animation: tw 5s ease-in-out infinite;
}
.orbit-star.replied { background: #A9BCFF; box-shadow: 0 0 9px 2px rgba(160,178,255,.9), 0 0 26px 8px rgba(160,178,255,.35); }
.orbit-star.replied::after {
  content: ''; position: absolute; left: -8rpx; top: -8rpx; right: -8rpx; bottom: -8rpx;
  border-radius: 50%; border: 1.5rpx solid rgba(178,192,255,.85);
}
.sky-star.replied { background: #A9BCFF; box-shadow: 0 0 9px 2px rgba(160,178,255,.85), 0 0 26px 8px rgba(160,178,255,.3); }
/* 已翻篇：金色四角星芒 */
.orbit-star.gold { background: #FFCE8A; border-radius: 0; clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%); box-shadow: 0 0 11px 3px rgba(255,206,138,.95), 0 0 30px 10px rgba(255,206,138,.4); }
.sky-star.gold { background: #FFCE8A; border-radius: 0; clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%); box-shadow: 0 0 10px 3px rgba(255,206,138,.9), 0 0 26px 8px rgba(255,206,138,.35); }
.orbit-star.fresh { animation: born 2.6s ease-out forwards; z-index: 5; }
.orbit-star.turning { animation: turnGold 2.2s ease-out forwards; z-index: 5; }
.orbit-star.beckon { animation: beckon 4.5s ease-in-out infinite; }

/* 底部：宋体大数字计数 + 发丝分割线 + 图例 + 提示 */
.orbit-count { position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 280rpx); text-align: center; }
.orbit-count-num { font-family: 'Songti SC', 'Noto Serif CJK SC', serif; font-size: 88rpx; font-weight: 700; color: #F2EDD9; line-height: 1.1; }
.orbit-count-lbl { margin-top: 4rpx; font-size: 24rpx; letter-spacing: .34em; text-indent: .34em; color: #7C84A6; }
.orbit-hairline {
  position: absolute; left: 116rpx; right: 116rpx; bottom: calc(env(safe-area-inset-bottom) + 240rpx); height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,210,255,.14), transparent);
}
.orbit-legend {
  position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 172rpx);
  display: flex; justify-content: center;
}
.orbit-legend .lg { display: flex; align-items: center; margin: 0 26rpx; padding: 16rpx 6rpx; color: #6E7694; font-size: 20rpx; letter-spacing: .18em; }
.lg-tap { opacity: .5; }
.lg-dot { width: 12rpx; height: 12rpx; border-radius: 50%; background: #F4F1E6; margin-right: 12rpx; box-shadow: 0 0 6px 2px rgba(244,241,230,.5); }
.lg-dot.gold { background: #FFCE8A; border-radius: 0; clip-path: polygon(50% 0%,63% 37%,100% 50%,63% 63%,50% 100%,37% 63%,0% 50%,37% 37%); width: 16rpx; height: 16rpx; box-shadow: 0 0 6px 2px rgba(255,206,138,.7); }
.lg-dot.blue { position: relative; background: #A9BCFF; box-shadow: 0 0 6px 2px rgba(160,178,255,.6); }
.lg-dot.blue::after { content: ''; position: absolute; left: -6rpx; top: -6rpx; right: -6rpx; bottom: -6rpx; border-radius: 50%; border: 1.5rpx solid rgba(178,192,255,.9); }

/* 翻篇仪式：全屏金光一闪 */
.gold-flash {
  position: fixed; inset: 0; z-index: 80; pointer-events: none; opacity: 0;
  background: radial-gradient(circle at 50% 44%, rgba(255,215,154,.38), rgba(255,215,154,.12) 42%, rgba(255,215,154,0) 72%);
}
.gold-flash.on { animation: flashGold 1.8s ease-out; }
@keyframes flashGold { 0% { opacity: 0; } 18% { opacity: 1; } 100% { opacity: 0; } }
.orbit-hint {
  position: absolute; left: 0; right: 0; bottom: calc(env(safe-area-inset-bottom) + 100rpx);
  text-align: center; color: #4A5168; font-size: 20rpx; letter-spacing: .3em;
}
@media (prefers-reduced-motion: reduce) {
  .orbit-ring { animation-duration: 9999s; }
  .sun-core { animation: none; }
  .orbit-star.turning { animation-duration: .8s; animation-iteration-count: 1; }
}

.hero { margin-top: 14vh; position: relative; z-index: 2; }

.after-release { display: none; text-align: center; margin-bottom: 20rpx; animation: rise 1.2s ease; }
.after-release.on { display: block; }
.ar-txt { color: #8b90a8; font-size: 28rpx; line-height: 2; margin-bottom: 8rpx; }
@keyframes rise { from { opacity: 0; transform: translateY(24rpx); } to { opacity: 1; transform: none; } }

.revisit-banner {
  display: block; width: 100%; margin-bottom: 24rpx; padding: 26rpx 32rpx;
  background: rgba(255,215,154,.05); border: 1rpx solid rgba(255,215,154,.20);
  border-radius: 32rpx; color: rgba(255,215,154,.88);
  font-size: 27rpx; letter-spacing: .10em; text-align: center;
  font-family: "Songti SC", "STSong", serif; animation: rise 1.2s ease;
}

/* 送星按钮与回音 */
.turn.send { border-color: rgba(185,195,255,.35); color: #b9c3ff; margin-top: 20rpx; }
.reply-card { margin-top: 32rpx; border-left: 2rpx solid rgba(255,215,154,.4); padding-left: 24rpx; }
.reply-meta { font-size: 22rpx; color: #ffd79a; letter-spacing: .2em; margin-bottom: 12rpx; }
.reply-text { font-size: 30rpx; line-height: 2; color: #8b90a8; }

.rv-input {
  width: 100%; min-height: 200rpx; box-sizing: border-box;
  background: rgba(255,255,255,.04); border: 1rpx solid rgba(255,255,255,.08);
  border-radius: 24rpx; padding: 24rpx; color: #eef0f7; font-size: 30rpx; line-height: 1.9;
}

@media (prefers-reduced-motion: reduce) {
  .bg-star, .sky-star { animation-duration: .01s; animation-iteration-count: 1; }
  .sky-star.turning { animation-duration: .8s; animation-iteration-count: 1; }
}
