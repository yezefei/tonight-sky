/* 星星详情页 · 深空观测台 */
.page-list {
  position: relative;
  min-height: 100vh;
  padding: 0 56rpx calc(env(safe-area-inset-bottom) + 60rpx);
  box-sizing: border-box;
  display: flex; flex-direction: column;
  background: radial-gradient(120% 70% at 50% 30%, #0B1128 0%, #060913 46%, #030409 100%);
  color: #eef0f7;
}

/* 页头 */
.sd-head { text-align: center; margin-top: 24rpx; }
.sd-eyebrow {
  font-family: monospace; font-size: 20rpx; letter-spacing: .4em; text-indent: .4em;
  color: rgba(169,188,255,.75);
}
.sd-title {
  margin-top: 18rpx;
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 52rpx; font-weight: 600; letter-spacing: .22em; text-indent: .22em;
  color: #F2EDD9;
}
.sd-sub { margin-top: 14rpx; font-family: monospace; font-size: 21rpx; letter-spacing: .14em; color: #8b90a8; }
.sd-hairline {
  margin: 36rpx 16rpx 8rpx; height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(200,210,255,.14), transparent);
}

/* 正文 */
.sd-text {
  margin-top: 44rpx;
  font-family: 'Songti SC', 'Noto Serif CJK SC', serif;
  font-size: 34rpx; line-height: 2.1; color: #E8E4D6;
}
.sd-mood { margin-top: 16rpx; font-size: 22rpx; letter-spacing: .1em; color: #ffd79a; }

/* 回音块 */
.reply-card {
  margin-top: 40rpx; padding: 24rpx 28rpx; border-radius: 16rpx;
  background: rgba(169,188,255,.05); border-left: 3rpx solid rgba(169,188,255,.45);
}
.reply-meta { font-family: monospace; font-size: 19rpx; letter-spacing: .3em; color: rgba(169,188,255,.7); margin-bottom: 12rpx; }
.reply-text { font-size: 29rpx; line-height: 2; color: #C6D2F5; }
.ack-btn {
  display: inline-block; margin-top: 22rpx; padding: 12rpx 28rpx; border-radius: 999rpx;
  border: 1rpx solid rgba(255,206,138,.4); color: #ffd79a;
  font-size: 22rpx; letter-spacing: .2em; text-indent: .2em;
}
.ack-done { margin-top: 22rpx; color: #8b90a8; font-size: 22rpx; letter-spacing: .14em; }

.sent-tag { margin-top: 36rpx; font-size: 22rpx; letter-spacing: .2em; color: #7c84a6; }
.gold-tag { margin-top: 36rpx; font-size: 22rpx; letter-spacing: .24em; color: #C9A86A; }

/* 操作区 */
.sd-actions { margin-top: 72rpx; }
.btn-ghost.dis { opacity: .35; }
.sd-row { display: flex; justify-content: center; margin-top: 40rpx; }
.sd-link {
  margin: 0 12rpx; padding: 16rpx 28rpx;
  color: #b9c3ff; font-size: 24rpx; letter-spacing: .12em;
  border: 1rpx solid rgba(185,195,255,.3); border-radius: 999rpx;
}
.sd-del { text-align: center; margin-top: 48rpx; color: #a87f7f; font-size: 22rpx; letter-spacing: .12em; }

/* 编辑模式 */
.edit-box { margin-top: 40rpx; background: rgba(255,255,255,.04); border: 1rpx solid rgba(255,255,255,.08); border-radius: 28rpx; padding: 28rpx; }
.edit-area { width: 100%; min-height: 240rpx; color: #eef0f7; font-size: 32rpx; line-height: 2; }
.ph { color: #7c84a6; }
.chips { display: flex; flex-wrap: wrap; margin-top: 24rpx; }
.chip {
  flex: 0 0 auto; width: auto;
  padding: 14rpx 30rpx; border-radius: 999rpx; font-size: 26rpx;
  background: none; border: 1rpx solid rgba(255,255,255,.10); color: #8b90a8;
  margin: 0 16rpx 16rpx 0; line-height: 1.8;
}
.chip.sel { border-color: rgba(255,215,154,.5); color: #ffd79a; background: rgba(255,215,154,.06); }
.edit-actions { margin-top: 32rpx; }

/* 翻篇撤销条 */
.sd-undo {
  position: fixed; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 80rpx);
  transform: translateX(-50%); z-index: 50; white-space: nowrap;
  padding: 18rpx 38rpx; border-radius: 999rpx;
  background: rgba(16,21,48,.94); border: 1rpx solid rgba(255,206,138,.35);
  color: #ffd79a; font-size: 22rpx; letter-spacing: .14em;
  box-shadow: 0 8px 32px rgba(0,0,0,.5);
}

/* 兜底 */
.sd-gone { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.gone-txt { text-align: center; color: #7c84a6; font-size: 26rpx; letter-spacing: .2em; margin-bottom: 60rpx; }

/* 矮屏：正文与操作区收紧，编辑框仍保留足够高度 */
@media (max-height: 700px) {
  .sd-head { margin-top: 14rpx; }
  .sd-title { font-size: 44rpx; margin-top: 12rpx; }
  .sd-hairline { margin-top: 22rpx; }
  .sd-text { margin-top: 28rpx; font-size: 32rpx; }
  .reply-card { margin-top: 26rpx; }
  .sd-actions { margin-top: 44rpx; }
  .sd-row { margin-top: 28rpx; }
  .sd-del { margin-top: 32rpx; }
  .edit-box { margin-top: 26rpx; padding: 20rpx; }
  .edit-area { min-height: 180rpx; }
}
