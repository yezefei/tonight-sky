.back {
  position: fixed; left: 28rpx; z-index: 30;
  display: flex; align-items: center; gap: 10rpx;
  color: #b9c3ff; font-size: 52rpx; line-height: 1;
}
.back-txt { font-size: 26rpx; letter-spacing: .1em; }

.eyebrow {
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  font-size: 22rpx; letter-spacing: .34em; color: rgba(169,188,255,.75);
  margin-bottom: 18rpx;
}
.h2 { font-family: "Songti SC", "STSong", serif; font-size: 46rpx; letter-spacing: .06em; }
.intro { color: #8b90a8; font-size: 26rpx; line-height: 2; margin-top: 12rpx; }

.month-bar {
  display: flex; align-items: center; justify-content: space-between;
  margin-top: 36rpx; padding: 8rpx 12rpx;
}
.m-label { font-family: "Songti SC", "STSong", serif; font-size: 34rpx; color: #f2edd9; letter-spacing: .1em; }
.m-arrow {
  width: 72rpx; height: 72rpx; text-align: center; line-height: 68rpx;
  font-size: 48rpx; color: #b9c3ff; border: 1rpx solid rgba(185,195,255,.18); border-radius: 50%;
}
.m-arrow.off { opacity: .25; }

.calendar {
  margin-top: 16rpx; padding: 22rpx 16rpx 26rpx;
  border: 1rpx solid rgba(255,255,255,.07); border-radius: 28rpx;
  background: rgba(255,255,255,.02);
}
.week-row { display: flex; padding-bottom: 14rpx; border-bottom: 1rpx solid rgba(255,255,255,.05); }
.week-cell {
  flex: 1; text-align: center; font-size: 22rpx; letter-spacing: .14em; color: #6b7189;
}
.day-grid { display: flex; flex-wrap: wrap; }
.day-cell {
  position: relative; width: calc(100% / 7); height: 88rpx;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  border-radius: 16rpx;
}
.day-cell.blank { pointer-events: none; }
.d-num { font-size: 26rpx; color: #9ba4c4; font-variant-numeric: tabular-nums; }
.day-cell.today .d-num { color: #fff6e3; }
.day-cell.today { box-shadow: inset 0 0 0 1rpx rgba(255,215,154,.35); }
.day-cell.sel { background: rgba(255,215,154,.08); box-shadow: inset 0 0 0 1rpx rgba(255,215,154,.55); }
.day-cell.sel .d-num { color: #ffd79a; }
.d-dot { width: 10rpx; height: 10rpx; margin-top: 8rpx; border-radius: 50%; background: #b9c3ff; }
.day-cell.warm .d-dot { background: #ffd79a; box-shadow: 0 0 10rpx rgba(255,215,154,.45); }
.day-cell.cool .d-dot { background: #9fb0dc; box-shadow: 0 0 10rpx rgba(159,176,220,.35); }

.legend {
  display: flex; align-items: center; flex-wrap: wrap; gap: 18rpx;
  margin-top: 18rpx; padding: 0 10rpx;
}
.lg { display: flex; align-items: center; gap: 8rpx; font-size: 21rpx; color: #8b90a8; }
.lg-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }
.lg-dot.warm { background: #ffd79a; }
.lg-dot.cool { background: #9fb0dc; }
.lg-dot.plain { background: #b9c3ff; }
.lg-note { width: 100%; font-size: 20rpx; color: #596183; letter-spacing: .04em; }

.detail-card, .hint-card, .analysis {
  margin-top: 30rpx; padding: 28rpx 30rpx;
  border: 1rpx solid rgba(255,255,255,.07); border-radius: 28rpx;
  background: rgba(255,255,255,.02);
}
.detail-head {
  font-family: "Songti SC", "STSong", serif; font-size: 30rpx; color: #ffd79a;
  padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.detail-item { padding: 22rpx 0; border-bottom: 1rpx solid rgba(255,255,255,.05); }
.detail-item:last-child { border-bottom: none; padding-bottom: 4rpx; }
.di-top { display: flex; align-items: center; flex-wrap: wrap; gap: 14rpx; font-size: 21rpx; color: #8b90a8; }
.di-tag { color: #b9c3ff; }
.di-mood { color: #9ed7c6; }
.di-done { color: #ffce8a; }
.di-text {
  margin-top: 12rpx; font-size: 27rpx; line-height: 1.85; color: #f2edd9;
  font-family: "Songti SC", "STSong", serif;
}
.hint-card { text-align: center; color: #7c84a6; font-size: 24rpx; letter-spacing: .08em; }

.an-head {
  font-family: "Songti SC", "STSong", serif; font-size: 32rpx; color: #f2edd9;
  padding-bottom: 18rpx; border-bottom: 1rpx solid rgba(255,255,255,.06);
}
.an-lead { margin-top: 20rpx; font-size: 26rpx; line-height: 1.9; color: #b9c3ff; }
.an-em { color: #ffd79a; font-size: 32rpx; font-family: "Songti SC", "STSong", serif; }
.an-block { margin-top: 28rpx; }
.an-sub { font-size: 22rpx; color: #7c84a6; letter-spacing: .12em; margin-bottom: 16rpx; }
.stat-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 14rpx; }
.st-name { width: 96rpx; font-size: 24rpx; color: #f2edd9; }
.st-track { flex: 1; height: 8rpx; border-radius: 999rpx; background: rgba(255,255,255,.06); overflow: hidden; }
.st-bar { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #9ed7c6, #ffd79a); }
.st-n { width: 40rpx; text-align: right; font-size: 22rpx; color: #8b90a8; font-variant-numeric: tabular-nums; }
.tag-list { display: flex; flex-wrap: wrap; gap: 14rpx; }
.tag-chip {
  padding: 10rpx 22rpx; border-radius: 999rpx; font-size: 22rpx; color: #b9c3ff;
  border: 1rpx solid rgba(185,195,255,.2); background: rgba(185,195,255,.05);
}
.an-empty { margin-top: 20rpx; font-size: 25rpx; line-height: 1.9; color: #7c84a6; }

.bottom-space { height: calc(env(safe-area-inset-bottom) + 60rpx); }

@media (max-height: 700px) {
  .intro { margin-top: 6rpx; font-size: 24rpx; }
  .month-bar { margin-top: 22rpx; }
  .day-cell { height: 76rpx; }
  .detail-card, .hint-card, .analysis { margin-top: 22rpx; padding: 22rpx 24rpx; }
}
